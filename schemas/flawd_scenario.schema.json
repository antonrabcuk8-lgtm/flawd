{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/antonrabcuk8-lgtm/flawd/schemas/flawd_scenario.schema.json",
  "title": "FlawdScenario",
  "type": "object",
  "required": [
    "id",
    "status",
    "title",
    "prompt",
    "mock_tools",
    "assertions",
    "category",
    "severity",
    "provenance",
    "mitigation",
    "source"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^FLAWD-[0-9]{4}-[0-9]{4}$" },
    "status": {
      "type": "string",
      "enum": ["draft", "auto-verified", "verified", "synthetic", "stale", "rejected"]
    },
    "relevance": { "type": "integer", "minimum": 1, "maximum": 10 },
    "title": { "type": "string", "minLength": 8 },
    "summary": { "type": "string" },
    "failure_mechanism": { "type": "string" },
    "category": { "type": "string", "minLength": 2 },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "provenance": {
      "type": "string",
      "enum": ["github-inspired", "synthetic"]
    },
    "mitigation": { "type": "string", "minLength": 8 },
    "prompt": { "type": "string", "minLength": 8 },
    "reproduction_hints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mock_tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "behavior"],
        "properties": {
          "name": { "type": "string" },
          "behavior": {
            "type": "string",
            "enum": ["success", "error", "timeout", "malformed_json", "inject"]
          },
          "status": { "type": ["integer", "null"] },
          "delay_ms": { "type": "integer", "minimum": 0 },
          "body": { "type": "string" }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "max_tool_calls",
              "min_tool_calls",
              "max_repeats",
              "max_tokens",
              "max_duration_sec",
              "must_not_contain",
              "must_stop"
            ]
          },
          "tool": { "type": ["string", "null"] },
          "min": { "type": ["number", "null"] },
          "max": { "type": ["number", "null"] },
          "value": { "type": ["string", "null"] }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "id": { "type": ["string", "integer", "null"] },
        "url": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "accessed": { "type": ["string", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "url": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
